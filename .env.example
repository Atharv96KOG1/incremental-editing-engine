OPENAI_API_KEY=
LLM_MODEL=gpt-5.4

# Leave MINIO_ENDPOINT empty to use local-disk storage (./minio_local_data) instead.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=incremental-poc
LOCAL_STORAGE_DIR=./minio_local_data/incremental-poc

# Optional: override per-1K-token pricing once known, e.g. {"gpt-5.4": [0.005, 0.015]}
LLM_PRICING_JSON=

# Optional: TypeSafe AI's Jev model (docs.typesafe.ai) pre-classifies a
# request's escalate kind before STRUCTURED_EDIT's own classification call
# runs, skipping it entirely when confident. Leave empty to disable --
# every request then runs exactly as it did before Jev existed.
TYPESAFE_API_KEY=
JEV_CONFIDENCE_THRESHOLD=0.80

# Optional: pending human-confirmation runs (web UI's accept/reject gate)
# are held in Redis instead of an in-memory dict when set -- survives a
# server restart and works across more than one worker. Leave empty to
# keep the in-memory default (fine for a single `iee serve` process).
REDIS_URL=
PENDING_CONFIRMATION_TTL_SECONDS=86400
